   "source": [
    "dp = [ [0 for _ in range(3)] for _ in range(N//3 +1)]\n",
    "dp[0][0] = 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {},
   "outputs": [],
   "source": [
    "for n in range(1, N//3 + 1):\n",
    "    a, b, c = dp[n-1]\n",
    "    dp[n] = [(3*a + 2 * b + 2 * c) % MOD , (a+b)% MOD, (a+b+c) % MOD]"
   ]
